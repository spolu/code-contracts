{
  "name": "cc-check",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line tooling for code contracts",
  "type": "module",
  "bin": {
    "cc-check": "./dist/cc-check.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:integration",
    "dev": "tsx src/cc-check.ts",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint --cache --cache-location .eslintcache src/",
    "test": "npm run test:integration",
    "test:integration": "npm run build && node test/integration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=11.11.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "pyright": "^1.1.413",
    "typescript": "^6.0.3",
    "typescript-language-server": "^6.0.0",
    "vscode-languageserver-protocol": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.68.0"
  },
  "packageManager": "npm@11.11.0"
}
