{
  "name": "@spolu/cc-check",
  "version": "0.2.0",
  "description": "Command-line tooling for code contracts",
  "keywords": [
    "code-contracts",
    "contracts",
    "cli",
    "static-analysis",
    "developer-tools"
  ],
  "homepage": "https://github.com/spolu/code-contracts#readme",
  "bugs": {
    "url": "https://github.com/spolu/code-contracts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spolu/code-contracts.git",
    "directory": "cc-check"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "cc-check": "dist/cc-check.js"
  },
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:integration",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/cc-check.ts",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint --cache --cache-location .eslintcache src/",
    "prepack": "npm run check",
    "test": "npm run test:integration",
    "test:integration": "npm run build && node test/integration.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=11.11.0"
  },
  "dependencies": {
    "@lezer/common": "^1.5.2",
    "@lezer/go": "^1.0.1",
    "@lezer/python": "^1.1.19",
    "@lezer/rust": "^1.0.2",
    "commander": "^15.0.0",
    "pyright": "^1.1.413",
    "typescript": "^6.0.3",
    "typescript-language-server": "^6.0.0",
    "vscode-languageserver-protocol": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.68.0"
  },
  "packageManager": "npm@11.11.0"
}
